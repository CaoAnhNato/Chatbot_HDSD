# Application Settings
PROJECT_NAME="Multimodal HDSD Chatbot Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Qwen API Settings (DashScope or OpenRouter)
QWEN_API_KEY="sk-your-qwen-or-dashscope-api-key-here"
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL_NAME="qwen-turbo" # hoặc qwen-3.7-flash, qwen-plus, qwen-max
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.8
LLM_MAX_TOKENS=1500

# Vector Database Settings
VECTOR_DB_TYPE="qdrant" # "qdrant" hoặc "chroma"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="hdsd_chunks"
CHROMA_PERSIST_DIRECTORY="./chroma_data"

# Embedding Settings
EMBEDDING_MODEL_NAME="BAAI/bge-m3"

# Storage Settings
IMAGE_STORAGE_PATH="./data/extracted_images"
BASE_IMAGE_CDN_URL="http://localhost:8000/static/images"

# Redis Cache Settings
REDIS_ENABLED=false
REDIS_HOST="localhost"
REDIS_PORT=6379
