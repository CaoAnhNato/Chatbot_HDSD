# =================================================================
# IPGov Chatbot & Backend Environment Variables (TEMPLATE)
# Sao chép tệp này thành .env và điền các API keys tương ứng
# =================================================================

# 1. LLM API Keys
DASHSCOPE_API_KEY=your_dashscope_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 2. Hugging Face & External Platform Tokens
HF_TOKEN=your_huggingface_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# 3. Security & Authentication (JWT & Internal Sync)
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
INTERNAL_SYNC_SECRET=change_this_to_a_secure_internal_token_in_production

# 4. Kho Dữ Liệu DWH PostgreSQL (Docker: vna_wom_dev)
DWH_HOST=localhost
DWH_PORT=5432
DWH_USER=postgres
DWH_PASSWORD=postgres
DWH_DB=vna_wom_dev

# 5. Supabase (Dữ liệu kế thừa Chatbot HDSD)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PASS=your_supabase_password_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
